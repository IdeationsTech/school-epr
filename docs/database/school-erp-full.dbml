  staff_profile_id "bigint unsigned" [not null]
  starts_on date [not null]
  ends_on date [not null]
  leave_type varchar(160) [not null]
  reason text [null]
  status varchar(160) [not null]
  approved_by "bigint unsigned" [null]
  lock_version "int unsigned" [not null, default: 0]
  review_note text [null]
  reviewed_at datetime [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't25_school_id']
  }
  checks {
    `ends_on >= starts_on` [name: 't25_check0']
  }
}

Table academic_sessions {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  starts_on date [not null]
  ends_on date [not null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
