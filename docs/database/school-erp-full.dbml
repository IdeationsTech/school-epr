  required_for_diary boolean [not null, default: false]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't31_school_id']
    (school_id, section_id, subject_id) [unique, name: 't31_u0']
