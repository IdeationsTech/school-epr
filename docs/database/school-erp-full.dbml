Table payment_reversals {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  payment_id "bigint unsigned" [not null]
  amount decimal(12,2) [not null]
  reason text [not null]
  status varchar(160) [not null]
  approved_by "bigint unsigned" [null]
  reversed_at datetime [null]
  idempotency_key varchar(160) [not null]
  kind varchar(160) [null]
  refund_method varchar(160) [null]
  refund_reference varchar(160) [null]
  refund_bank_account_id "bigint unsigned" [null]
  reversed_by "bigint unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't49_school_id']
    (school_id, idempotency_key) [unique, name: 't49_u0']
  }
  checks {
    `amount > 0` [name: 't49_check0']
    `kind IS NULL OR kind IN ('correction','refund')` [name: 't49_check1']
    `refund_method IS NULL OR refund_method IN ('cash','bank_transfer','jazzcash','easypaisa')` [name: 't49_check2']
    `kind IS NULL OR kind <> 'refund' OR refund_method IS NOT NULL` [name: 't49_check3']
  }
}

