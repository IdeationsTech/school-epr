  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't32_school_id']
  }
}

Table admission_inquiries {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  campus_id "bigint unsigned" [not null]
  child_name varchar(160) [not null]
  guardian_name varchar(160) [not null]
  phone varchar(160) [not null]
  status varchar(160) [not null]
  follow_up_on date [null]
  notes text [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't33_school_id']
  }
}

Table admission_applications {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  inquiry_id "bigint unsigned" [null]
  campus_id "bigint unsigned" [not null]
  class_id "bigint unsigned" [not null]
  academic_session_id "bigint unsigned" [not null]
  application_no varchar(160) [not null]
  student_name varchar(160) [not null]
  birth_date date [null]
  guardian_details json [not null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't34_school_id']
    (school_id, application_no) [unique, name: 't34_u0']
  }
}

Table students {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  admission_no varchar(160) [not null]
  first_name varchar(160) [not null]
  last_name varchar(160) [null]
  birth_date date [null]
  gender varchar(160) [null]
  admitted_on date [not null]
  status varchar(160) [not null]
  application_id "bigint unsigned" [null]
  photo_file_id "bigint unsigned" [null]
  identity_number varchar(13) [null]
  identity_type varchar(160) [null]
  address text [null]
  previous_school varchar(160) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't35_school_id']
    (school_id, admission_no) [unique, name: 't35_u0']
    (school_id, identity_number) [unique, name: 't35_u1']
  }
  checks {
    `(identity_number IS NULL AND identity_type IS NULL) OR (identity_number IS NOT NULL AND identity_number REGEXP '^[0-9]{13}$' AND identity_type IS NOT NULL AND identity_type IN ('cnic','b_form'))` [name: 't35_check0']
    `birth_date IS NULL OR birth_date <= admitted_on` [name: 't35_check1']
  }
}

Table guardians {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  phone varchar(160) [not null]
  alternate_phone varchar(160) [null]
  email varchar(160) [null]
  address text [null]
  cnic varchar(13) [null]
  whatsapp_phone varchar(160) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't36_school_id']
    (school_id, cnic) [unique, name: 't36_u0']
  }
  checks {
    `cnic IS NULL OR cnic REGEXP '^[0-9]{13}$'` [name: 't36_check0']
  }
}

Table student_guardians {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  student_id "bigint unsigned" [not null]
  guardian_id "bigint unsigned" [not null]
  relationship varchar(160) [not null]
  is_primary boolean [not null, default: false]
  can_receive_reports boolean [not null, default: false]
  can_pick_up boolean [not null, default: false]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't37_school_id']
    (school_id, student_id, guardian_id) [unique, name: 't37_u0']
  }
}

