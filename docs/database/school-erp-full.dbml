  roll_no varchar(160) [null]
  starts_on date [not null]
  ends_on date [null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't38_school_id']
    (school_id, student_id, section_id, starts_on) [unique, name: 't38_u0']
  }
  checks {
    `ends_on IS NULL OR ends_on >= starts_on` [name: 't38_check0']
  }
}

Table student_documents {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
