  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't40_school_id']
    (school_id, code) [unique, name: 't40_u0']
  }
}

Table fee_plans {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  academic_session_id "bigint unsigned" [not null]
  class_id "bigint unsigned" [not null]
  campus_id "bigint unsigned" [null]
  name varchar(160) [not null]
  starts_on date [not null]
  ends_on date [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't41_school_id']
  }
  checks {
    `ends_on IS NULL OR ends_on >= starts_on` [name: 't41_check0']
  }
}

Table fee_plan_items {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  fee_plan_id "bigint unsigned" [not null]
  fee_head_id "bigint unsigned" [not null]
  amount decimal(12,2) [not null]
  frequency varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't42_school_id']
  }
  checks {
    `amount >= 0` [name: 't42_check0']
  }
}

Table student_concessions {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  enrollment_id "bigint unsigned" [not null]
  fee_head_id "bigint unsigned" [not null]
  kind varchar(160) [not null]
  value decimal(12,2) [not null]
  starts_on date [not null]
  ends_on date [null]
  reason text [null]
  approved_by "bigint unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't43_school_id']
  }
  checks {
    `kind IN ('fixed','percent')` [name: 't43_check0']
    `value >= 0` [name: 't43_check1']
    `kind <> 'percent' OR value <= 100` [name: 't43_check2']
    `ends_on IS NULL OR ends_on >= starts_on` [name: 't43_check3']
  }
}

Table invoices {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  enrollment_id "bigint unsigned" [not null]
  number varchar(160) [not null]
  period date [not null]
  kind varchar(160) [not null]
  installment_no "int unsigned" [not null]
  issued_on date [not null]
  due_on date [not null]
  status varchar(160) [not null]
  total decimal(12,2) [not null]
  void_reason text [null]
  fee_assignment_id "bigint unsigned" [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't44_school_id']
    (school_id, number) [unique, name: 't44_u0']
    (school_id, enrollment_id, period, kind, installment_no) [unique, name: 't44_u1']
  }
  checks {
    `total >= 0` [name: 't44_check0']
  }
}

Table invoice_items {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  invoice_id "bigint unsigned" [not null]
  fee_head_id "bigint unsigned" [null]
  description varchar(160) [not null]
  quantity decimal(12,2) [not null]
  unit_amount decimal(12,2) [not null]
  discount_amount decimal(12,2) [not null]
  line_total decimal(12,2) [not null]
  billing_frequency varchar(160) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't45_school_id']
  }
  checks {
    `quantity > 0` [name: 't45_check0']
    `unit_amount >= 0` [name: 't45_check1']
    `discount_amount >= 0` [name: 't45_check2']
    `line_total >= 0` [name: 't45_check3']
    `discount_amount <= ROUND(quantity * unit_amount, 2) AND line_total = ROUND(quantity * unit_amount, 2) - discount_amount` [name: 't45_check4']
  }
}

Table bank_accounts {
