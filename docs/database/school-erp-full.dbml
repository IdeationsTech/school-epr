  role_id "bigint unsigned" [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't21_school_id']
    (school_id, membership_id, role_id) [unique, name: 't21_u0']
  }
}

Table membership_campuses {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  membership_id "bigint unsigned" [not null]
  campus_id "bigint unsigned" [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't22_school_id']
    (school_id, membership_id, campus_id) [unique, name: 't22_u0']
  }
}

Table files {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  campus_id "bigint unsigned" [null]
  uploaded_by "bigint unsigned" [null]
  disk varchar(160) [not null]
  path varchar(160) [not null]
  original_name varchar(160) [not null]
  mime_type varchar(160) [not null]
  size_bytes "int unsigned" [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't23_school_id']
    (school_id, disk, path) [unique, name: 't23_u0']
  }
}

Table staff_profiles {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  membership_id "bigint unsigned" [not null]
  employee_no varchar(160) [not null]
  designation varchar(160) [null]
  hired_on date [null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't24_school_id']
    (school_id, membership_id) [unique, name: 't24_u0']
    (school_id, employee_no) [unique, name: 't24_u1']
  }
}

Table leave_requests {
  id "bigint unsigned" [pk, increment, not null]
