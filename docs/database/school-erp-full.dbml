// School ERP — implemented database ERD
// 100 domain + 8 Laravel infrastructure + 1 migration tracking = 109 tables.
// Paste this entire file into the DBML editor at https://dbdiagram.io/.
// Diagram only: Laravel migrations remain the source for database creation.
// Composite references preserve school isolation. No invented logical FKs.

Project school_erp {
  database_type: 'MySQL'
  Note: 'MySQL 8.4 school ERP. 109 implemented tables. Future-only tables are grouped separately. Status values are strings unless a check explicitly restricts them. Cross-row business rules require application services.'
}

Table users {
  id "bigint unsigned" [pk, increment, not null]
  name varchar(255) [not null]
  email varchar(255) [not null, unique]
  email_verified_at timestamp [null]
  password varchar(255) [not null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
}

Table password_reset_tokens {
  email varchar(255) [pk, not null]
  token varchar(255) [not null]
  created_at timestamp [null]
}

Table sessions {
  id varchar(255) [pk, not null]
  user_id "bigint unsigned" [null, note: 'Indexed Laravel identity reference; no physical foreign key exists in the migration.']
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int [not null]
  indexes {
    user_id
    last_activity
  }
}

Table cache {
  key varchar(255) [pk, not null]
  value mediumtext [not null]
  expiration bigint [not null]
  indexes {
    expiration
  }
}

Table cache_locks {
  key varchar(255) [pk, not null]
  owner varchar(255) [not null]
  expiration bigint [not null]
  indexes {
    expiration
  }
}

Table jobs {
  id "bigint unsigned" [pk, increment, not null]
  queue varchar(255) [not null]
  payload longtext [not null]
  attempts "smallint unsigned" [not null]
  reserved_at "int unsigned" [null]
  available_at "int unsigned" [not null]
  created_at "int unsigned" [not null]
  indexes {
    queue
  }
}

Table job_batches {
  id varchar(255) [pk, not null]
  name varchar(255) [not null]
  total_jobs int [not null]
  pending_jobs int [not null]
  failed_jobs int [not null]
  failed_job_ids longtext [not null]
  options mediumtext [null]
  cancelled_at int [null]
  created_at int [not null]
  finished_at int [null]
}

Table failed_jobs {
  id "bigint unsigned" [pk, increment, not null]
  uuid varchar(255) [not null, unique]
  connection varchar(255) [not null]
  queue varchar(255) [not null]
  payload longtext [not null]
  exception longtext [not null]
  failed_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (connection, queue, failed_at)
  }
}

Table migrations {
  id "int unsigned" [pk, increment, not null]
  migration varchar(255) [not null]
  batch int [not null]
}

Table schools {
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  code varchar(160) [not null]
  timezone varchar(160) [not null]
  currency varchar(160) [not null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    code [unique, name: 't10_u0']
  }
}

Table plans {
  id "bigint unsigned" [pk, increment, not null]
  code varchar(160) [not null]
  name varchar(160) [not null]
  student_limit "int unsigned" [not null]
  campus_limit "int unsigned" [not null]
  monthly_price decimal(12,2) [not null]
  features json [null]
  annual_price decimal(12,2) [not null, default: 0]
  available boolean [not null, default: true]
  modules json [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    code [unique, name: 't11_u0']
  }
  checks {
    `monthly_price >= 0 AND annual_price >= 0 AND student_limit > 0 AND campus_limit > 0` [name: 't11_check0']
  }
}

Table permissions {
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  description varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    name [unique, name: 't12_u0']
  }
}

Table roles {
  id "bigint unsigned" [pk, increment, not null]
  name varchar(160) [not null]
  scope varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    name [unique, name: 't13_u0']
  }
}

Table role_permissions {
  id "bigint unsigned" [pk, increment, not null]
  role_id "bigint unsigned" [not null]
  permission_id "bigint unsigned" [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (role_id, permission_id) [unique, name: 't14_u0']
  }
}

Table campuses {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  name varchar(160) [not null]
  code varchar(160) [not null]
  address text [null]
  phone varchar(160) [null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't15_school_id']
    (school_id, code) [unique, name: 't15_u0']
  }
}

Table subscriptions {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  plan_id "bigint unsigned" [not null]
  starts_on date [not null]
  ends_on date [not null]
  status varchar(160) [not null]
  price decimal(12,2) [not null]
  license_id "bigint unsigned" [not null]
  kind varchar(160) [not null, default: 'paid']
  grace_days "int unsigned" [not null, default: 0]
  student_limit "int unsigned" [not null]
  campus_limit "int unsigned" [not null]
  modules json [not null]
  package_name varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't16_school_id']
  }
  checks {
    `ends_on >= starts_on` [name: 't16_check0']
    `price >= 0` [name: 't16_check1']
    `kind IN ('paid','trial') AND grace_days <= 30 AND (student_limit IS NULL OR student_limit > 0) AND (campus_limit IS NULL OR campus_limit > 0)` [name: 't16_check2']
  }
}

Table subscription_invoices {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  subscription_id "bigint unsigned" [not null]
  number varchar(160) [not null]
  issued_on date [not null]
  due_on date [not null]
  amount decimal(12,2) [not null]
  status varchar(160) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't17_school_id']
    (school_id, number) [unique, name: 't17_u0']
  }
  checks {
    `amount >= 0` [name: 't17_check0']
  }
}

Table subscription_payments {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  subscription_invoice_id "bigint unsigned" [not null]
  amount decimal(12,2) [not null]
  paid_at datetime [not null]
  method varchar(160) [not null]
  reference varchar(160) [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't18_school_id']
  }
  checks {
    `amount > 0` [name: 't18_check0']
  }
}

Table school_settings {
  id "bigint unsigned" [pk, increment, not null]
  school_id "bigint unsigned" [not null]
  key varchar(160) [not null]
  value json [null]
  created_at timestamp [null]
  updated_at timestamp [null]
  indexes {
    (school_id, id) [unique, name: 't19_school_id']
    (school_id, key) [unique, name: 't19_u0']
  }
}

